# ──────────────────────────────────────────────
# ATLAS Backend — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All variables are prefixed with ATLAS_ in the application config.

# Supabase Authentication
ATLAS_SUPABASE_URL=https://your-project-ref.supabase.co
ATLAS_SUPABASE_ANON_KEY=your-anon-key-here
ATLAS_SUPABASE_JWT_SECRET=your-jwt-secret-here

# Database
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:atlas@127.0.0.1:5432/atlas

# Application
ATLAS_ENV=development
ATLAS_DEBUG=true
ATLAS_LOG_LEVEL=INFO
