# ATLAS Environment Configuration
# DO NOT ADD SECRETS TO THIS FILE

# Frontend
WEB_BASE_URL=http://localhost:3000

# Backend API
ATLAS_ENV=development
ATLAS_DEBUG=true
ATLAS_LOG_LEVEL=INFO
ATLAS_API_HOST=127.0.0.1
ATLAS_API_PORT=8000
ATLAS_API_PREFIX=/api/v1
ATLAS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ClickHouse Infrastructure
ATLAS_CLICKHOUSE_ENABLED=false
ATLAS_CLICKHOUSE_HOST=127.0.0.1
ATLAS_CLICKHOUSE_PORT=8123
ATLAS_CLICKHOUSE_DATABASE=atlas
ATLAS_CLICKHOUSE_USERNAME=atlas_app
# Generate a secret: openssl rand -base64 32
ATLAS_CLICKHOUSE_PASSWORD=<your-secure-password-here>
ATLAS_CLICKHOUSE_SECURE=false
ATLAS_CLICKHOUSE_VERIFY_TLS=true
ATLAS_CLICKHOUSE_CONNECT_TIMEOUT_SECONDS=10
ATLAS_CLICKHOUSE_QUERY_TIMEOUT_SECONDS=30

# Valkey Infrastructure
ATLAS_VALKEY_ENABLED=false
ATLAS_VALKEY_HOST=127.0.0.1
ATLAS_VALKEY_PORT=6379
ATLAS_VALKEY_DATABASE=0
ATLAS_VALKEY_USERNAME=atlas_app
# Generate a secret: openssl rand -base64 32
ATLAS_VALKEY_PASSWORD=<your-secure-password-here>
ATLAS_VALKEY_SECURE=false
ATLAS_VALKEY_VERIFY_TLS=true
ATLAS_VALKEY_CONNECT_TIMEOUT_SECONDS=5
ATLAS_VALKEY_SOCKET_TIMEOUT_SECONDS=5
ATLAS_VALKEY_HEALTH_CHECK_INTERVAL_SECONDS=30
ATLAS_VALKEY_MAX_CONNECTIONS=100
ATLAS_VALKEY_KEY_PREFIX=atlas:dev:
